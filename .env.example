# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string (hosted Postgres e.g. Neon: use sslmode=verify-full so behavior
# matches future pg v9 / pg-connection-string v3; avoid bare require/prefer without uselibpqcompat)
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name
#DATABASE_URL=postgresql://user:pass@host/db?sslmode=verify-full

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: extra admin origins for Payload CSRF/CORS (comma-separated, no trailing slash).
# Use when editors open admin on multiple hosts, e.g. custom domain + *.vercel.app:
# PAYLOAD_TRUSTED_ORIGINS=https://www.suturly.com,https://suturly.com,https://suturly-v3.vercel.app

# Optional override: marketing modal normally reads the form from Globals → Marketing in Payload.
#NEXT_PUBLIC_PARTNER_CONTACT_FORM_ID=

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Danger: when true, allows POST /next/seed in production (wipes posts, pages, forms, etc.).
# Leave unset in real production. Local dev does not need this.
#ALLOW_DATABASE_SEED=true

# Optional: password-protect /resources and all paths under it (e.g. /resources/some-slug).
# Leave empty to disable the gate. Change the password anytime; users must sign in again.
# RESOURCES_GATE_SECRET defaults to PAYLOAD_SECRET if unset (used to sign the gate cookie).
#RESOURCES_GATE_PASSWORD=
#RESOURCES_GATE_SECRET=

# Resend email (for Form Builder emails, password reset, etc.)
# Without these, Payload falls back to the no-op console logger — emails are NOT delivered.
#RESEND_API_KEY=re_xxx
#RESEND_FROM_ADDRESS=noreply@suturly.com
#RESEND_FROM_NAME=Suturly

# Cloudflare R2 media storage (recommended for production/Vercel)
# Set R2_ENABLED=true only when all values below are configured
R2_ENABLED=false
R2_BUCKET=YOUR_R2_BUCKET
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# DeepL Free API key for the Resources content translator plugin.
# Get one from https://www.deepl.com/pro-api (Free tier). Leave unset to disable translation.
#DEEPL_API_KEY=YOUR_DEEPL_FREE_API_KEY
